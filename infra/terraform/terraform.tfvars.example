# Copy to terraform.tfvars (ignored by git) and fill in.
project_id = "prepza-prod"
region     = "europe-west1"
domain     = "prepza.ai"
image_tag  = "first"

mail_from         = "prepza. <no-reply@prepza.ai>"
mail_from_updates = "prepza. <updates@mail.prepza.ai>"
# Candidates' emails from a subdomain of their own, once it's verified in Resend (empty: mail_from).
# mail_from_candidates = "prepza. <invites@candidates.prepza.ai>"
# Resend's daily quota for your plan; bulk emails use at most 80% of it.
backend_sentry_dsn = ""
# The Firebase web app's apiKey (public), as the frontend's build has it: AI apps' calls over MCP
# sign the user in with it.
firebase_web_api_key = ""

# Outage and budget alerts (monitoring*.tf, budget.tf): pages to email, the Cloud Monitoring app
# and SMS; tickets to email only.
alert_email = "you@example.com"
# alert_app_channel = "projects/prepza-prod/notificationChannels/123"   # optional: the app's channel
# alert_sms         = "+3725550000"   # optional: pages by text message too, as a backup
billing_account = "XXXXXX-XXXXXX-XXXXXX"
monthly_budget  = 300

# "production" for the live site, with the production prices below (sandbox ones don't charge).
paddle_environment  = "sandbox"
paddle_client_token = ""
# The product every top-up is sold under; billing prices each one, in the company's currency.
paddle_product_candidates = ""
paddle_prices = {
  # A $0 monthly price: its checkout saves the card for automatic top-ups.
  auto_top_up = ""
}

# Who may open the superadmin pages (templates, the question bank, the emergency pause and
# maintenance mode). At least one is required.
superadmin_emails = ["you@example.com"]

# Sign in with GitHub and LinkedIn (README.md): empty leaves them off. Their client secrets go
# into Secret Manager (gcloud secrets versions add), never here.
github_client_id   = ""
linkedin_client_id = ""

# Optional: the tokens from Google Search Console's and Bing Webmaster Tools' meta-tag checks.
# google_site_verification = ""
# bing_site_verification   = ""
