{
 "about": "Made-up sounds that aren't speech, for voice mode's listening: what a candidate's microphone hears besides their answer (coughs, throat clearing, a sigh, knocks, a door, thunder, a chair, typing, a cup, a phone, room noise, music and a television in the background). Each is synthesised by ffmpeg from a formula (`source`, shaped by `filters` and set to a level by `gain`), never recorded; the television is two of voice.json's made-up messages, muffled and quiet. Built into audio/sound_<id>.ogg by build_voice_sounds.py, as Ogg Opus as browsers record. Nothing here may start a recording (voice_listening_test.mjs) or get a reaction from the server (voice_answers_test.py: the `noise` intent).",
 "built": "2026-10-30",
 "model": "ffmpeg formulas, by hand",
 "items": [
  {"id": "s01", "kind": "cough", "about": "two dry coughs, close", "source": "anoisesrc=c=white:a=0.9:d=1.6:r=48000", "filters": "bandpass=t=h:f=1000:w=1500,volume='if(between(t,0.3,0.6),exp(-(t-0.3)*10),0)+0.7*if(between(t,0.75,1.0),exp(-(t-0.75)*10),0)':eval=frame", "gain": 1.0},
  {"id": "s02", "kind": "cough", "about": "a hoarse cough with a voiced rasp, close", "source": "aevalsrc='(0.6*(random(0)*2-1)+0.4*(2*mod(130*t,1)-1))*(if(between(t,0.3,0.62),exp(-(t-0.3)*9),0)+0.8*if(between(t,0.78,1.05),exp(-(t-0.78)*9),0))':s=48000:d=1.6", "filters": "bandpass=t=h:f=900:w=1400", "gain": 1.6},
  {"id": "s03", "kind": "cough", "about": "a single cough, further away", "source": "anoisesrc=c=white:a=0.9:d=1.2:r=48000", "filters": "bandpass=t=h:f=800:w=1200,volume='if(between(t,0.3,0.65),exp(-(t-0.3)*8),0)':eval=frame", "gain": 0.4},
  {"id": "s04", "kind": "throat", "about": "throat clearing, a low voiced rasp", "source": "aevalsrc='(0.5*(2*mod((115+10*sin(2*PI*23*t))*t,1)-1)+0.5*(random(0)*2-1))*(if(between(t,0.3,0.7),sin(PI*(t-0.3)/0.4),0)+if(between(t,0.8,1.0),sin(PI*(t-0.8)/0.2),0))':s=48000:d=1.4", "filters": "lowpass=f=1800", "gain": 1.2},
  {"id": "s05", "kind": "sigh", "about": "a long sigh, breath through the mouth", "source": "anoisesrc=c=pink:a=0.6:d=2.0:r=48000", "filters": "bandpass=t=h:f=700:w=900,volume='if(between(t,0.3,1.6),sin(PI*(t-0.3)/1.3),0)':eval=frame", "gain": 1.0},
  {"id": "s06", "kind": "knock", "about": "three knocks on a door", "source": "aevalsrc='(sin(2*PI*190*t)+0.5*(random(0)*2-1))*exp(-45*mod(t-0.3,0.22))*between(t,0.3,0.96)':s=48000:d=1.5", "filters": "lowpass=f=2500", "gain": 0.8},
  {"id": "s07", "kind": "knock", "about": "knuckles on the desk, quick and quieter", "source": "aevalsrc='(sin(2*PI*320*t)+(random(0)*2-1))*exp(-80*mod(t-0.3,0.15))*between(t,0.3,0.9)':s=48000:d=1.3", "filters": "bandpass=t=h:f=900:w=1200", "gain": 0.5},
  {"id": "s08", "kind": "door", "about": "a door slammed in the room", "source": "aevalsrc='(0.8*sin(2*PI*65*t)*exp(-7*(t-0.3))+0.6*(random(0)*2-1)*exp(-35*(t-0.3)))*gte(t,0.3)':s=48000:d=1.8", "filters": "lowpass=f=1500", "gain": 1.0},
  {"id": "s09", "kind": "door", "about": "a door closing in the next room", "source": "aevalsrc='(0.8*sin(2*PI*80*t)*exp(-10*(t-0.3))+0.4*(random(0)*2-1)*exp(-50*(t-0.3)))*gte(t,0.3)':s=48000:d=1.4", "filters": "lowpass=f=800", "gain": 0.35},
  {"id": "s10", "kind": "thunder", "about": "a long rumble of thunder", "source": "anoisesrc=c=brown:a=1:d=4.5:r=48000", "filters": "lowpass=f=160,lowpass=f=160,volume='if(lt(t,1.0),t,exp(-(t-1.0)*0.9))':eval=frame", "gain": 5.0},
  {"id": "s11", "kind": "thunder", "about": "a thunderclap close by, then the rumble", "source": "aevalsrc='(random(0)*2-1)*(exp(-12*(t-0.3))*gte(t,0.3)+0.5*if(gte(t,0.5),exp(-(t-0.5)*1.1),0))':s=48000:d=4.0", "filters": "lowpass=f=900,lowpass=f=400", "gain": 1.5},
  {"id": "s12", "kind": "chair", "about": "a chair scraped across the floor", "source": "aevalsrc='(0.5*(2*mod((420+120*sin(2*PI*9*t))*t,1)-1)+0.5*(random(0)*2-1))*between(t,0.3,1.1)':s=48000:d=1.5", "filters": "bandpass=t=h:f=1100:w=900", "gain": 0.9},
  {"id": "s13", "kind": "chair", "about": "an office chair creaking as someone leans back", "source": "aevalsrc='(2*mod((240+60*sin(2*PI*3*t))*t,1)-1)*if(between(t,0.3,0.9),sin(PI*(t-0.3)/0.6),0)':s=48000:d=1.3", "filters": "bandpass=t=h:f=600:w=500", "gain": 0.6},
  {"id": "s14", "kind": "keyboard", "about": "typing on a keyboard", "source": "aevalsrc='(random(0)*2-1)*exp(-900*mod(t*9.7+0.4*sin(2*PI*1.3*t),1)/9.7)*between(t,0.3,3.3)':s=48000:d=3.6", "filters": "highpass=f=1500", "gain": 0.9},
  {"id": "s15", "kind": "cup", "about": "a cup set down hard on a saucer", "source": "aevalsrc='(sin(2*PI*2500*t)+0.7*sin(2*PI*3700*t)+0.5*sin(2*PI*5200*t))*exp(-25*(t-0.3))*gte(t,0.3)+0.5*(sin(2*PI*2500*t)+0.7*sin(2*PI*3700*t))*exp(-30*(t-0.45))*gte(t,0.45)':s=48000:d=1.2", "filters": "anull", "gain": 0.3},
  {"id": "s16", "kind": "phone", "about": "a phone's notification beeps", "source": "aevalsrc='0.5*sin(2*PI*880*t)*(between(t,0.3,0.45)+between(t,0.55,0.7))+0.4*sin(2*PI*1320*t)*between(t,0.8,1.0)':s=48000:d=1.4", "filters": "anull", "gain": 0.4},
  {"id": "s17", "kind": "clap", "about": "two hand claps", "source": "aevalsrc='(random(0)*2-1)*(exp(-60*(t-0.3))*gte(t,0.3)+exp(-60*(t-0.8))*gte(t,0.8))':s=48000:d=1.3", "filters": "bandpass=t=h:f=1500:w=2000", "gain": 1.0},
  {"id": "s18", "kind": "room", "about": "steady fan or street noise, as loud as under the noisy spoken answers", "source": "anoisesrc=c=pink:a=0.06:d=4.0:r=48000", "filters": "anull", "gain": 1.0},
  {"id": "s19", "kind": "room", "about": "a loud fan close to the microphone", "source": "anoisesrc=c=brown:a=0.5:d=4.0:r=48000", "filters": "highpass=f=60,lowpass=f=1200", "gain": 1.0},
  {"id": "s20", "kind": "music", "about": "instrumental music in the room: chords, a melody and a beat", "source": "aevalsrc='0.12*(sin(2*PI*(if(lt(mod(t,4),1),261.6,if(lt(mod(t,4),2),220,if(lt(mod(t,4),3),174.6,196))))*t)+sin(2*PI*1.26*(if(lt(mod(t,4),1),261.6,if(lt(mod(t,4),2),220,if(lt(mod(t,4),3),174.6,196))))*t)+sin(2*PI*1.5*(if(lt(mod(t,4),1),261.6,if(lt(mod(t,4),2),220,if(lt(mod(t,4),3),174.6,196))))*t))+0.15*sin(2*PI*523.3*pow(2,floor(mod(t*4,4))*2/12)*t)+0.4*(random(0)*2-1)*exp(-30*mod(t,0.5))':s=48000:d=5.0", "filters": "lowpass=f=5000", "gain": 0.7},
  {"id": "s21", "kind": "music", "about": "the same music quietly in the background", "source": "aevalsrc='0.12*(sin(2*PI*(if(lt(mod(t,4),1),261.6,if(lt(mod(t,4),2),220,if(lt(mod(t,4),3),174.6,196))))*t)+sin(2*PI*1.26*(if(lt(mod(t,4),1),261.6,if(lt(mod(t,4),2),220,if(lt(mod(t,4),3),174.6,196))))*t)+sin(2*PI*1.5*(if(lt(mod(t,4),1),261.6,if(lt(mod(t,4),2),220,if(lt(mod(t,4),3),174.6,196))))*t))+0.15*sin(2*PI*523.3*pow(2,floor(mod(t*4,4))*2/12)*t)+0.4*(random(0)*2-1)*exp(-30*mod(t,0.5))':s=48000:d=5.0", "filters": "lowpass=f=5000", "gain": 0.15},
