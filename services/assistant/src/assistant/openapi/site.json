     "intro": {
      "type": "string",
      "title": "Intro"
     },
     "version": {
      "type": "string",
      "title": "Version"
     },
     "state": {
      "type": "string",
      "enum": [
       "in_force",
       "upcoming",
       "replaced"
      ],
      "title": "State"
     },
     "current": {
      "type": "string",
      "title": "Current"
     },
     "in_force": {
      "type": "string",
      "title": "In Force"
     },
     "versions": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Versions"
     },
     "sections": {
      "items": {
       "$ref": "#/components/schemas/LegalSectionOut"
      },
      "type": "array",
      "title": "Sections"
     }
    },
    "type": "object",
    "required": [
     "language",
     "intro",
     "version",
     "state",
     "current",
     "in_force",
     "versions",
     "sections"
    ],
    "title": "LegalOut"
   },
   "LegalSectionOut": {
    "properties": {
     "heading": {
      "type": "string",
      "title": "Heading"
     },
     "paragraphs": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Paragraphs",
      "default": []
     },
     "items": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Items",
      "default": []
     }
    },
    "type": "object",
    "required": [
     "heading"
    ],
    "title": "LegalSectionOut"
   },
   "PageGuideOut": {
    "properties": {
     "key": {
      "type": "string",
      "title": "Key"
     },
     "title": {
      "type": "string",
      "title": "Title"
     },
     "text": {
      "type": "string",
      "title": "Text"
     },
     "actions": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Actions"
     },
     "tips": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Tips"
     },
     "article": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/GuideItemOut"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object",
    "required": [
     "key",
     "title",
     "text",
     "actions",
     "tips"
    ],
    "title": "PageGuideOut",
    "description": "A page's guide: what it's for (`text`), what you can do there, tips, and the guide\narticle to read more in, if the page has one."
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  },
  "securitySchemes": {
   "HTTPBearer": {
    "type": "http",
    "scheme": "bearer"
   }
  }
 }
}
