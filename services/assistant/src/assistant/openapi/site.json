  "/help/legal/{document}": {
   "get": {
    "tags": [
     "help"
    ],
    "summary": "Get Legal",
    "description": "The terms, the privacy policy or the DPA: the current version, or an earlier one, with\nevery published version (the day each applies from), in `language` when it's translated\n(the English text is the binding one); public.",
    "operationId": "get_legal_help_legal__document__get",
