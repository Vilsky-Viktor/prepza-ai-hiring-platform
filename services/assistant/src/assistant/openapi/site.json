     },
     "title": {
      "type": "string",
      "title": "Title"
     },
     "description": {
      "type": "string",
      "title": "Description"
     },
     "updated": {
      "type": "string",
      "title": "Updated"
     },
     "path": {
      "type": "string",
      "title": "Path"
     },
     "body": {
      "type": "string",
      "title": "Body"
     }
