{
 "paths": {
  "/help/faq": {
   "get": {
    "tags": [
     "help"
    ],
    "summary": "Get Faq",
    "description": "The FAQ in the page's language, with today's prices in the currency of the visitor's\n`country` (the site passes it on; US dollars without one); public. Without prices (billing not\nanswering) it's refused rather than built with blanks: the site keeps its last good page.",
    "operationId": "get_faq_help_faq_get",
    "parameters": [
     {
      "name": "country",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Country"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/FaqItemOut"
         },
         "title": "Response Get Faq Help Faq Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/help/guide": {
   "get": {
    "tags": [
     "help"
    ],
    "summary": "Get Guide",
    "description": "Everything prepza's help chat (in the assistant) answers from, as text: how prepza works and how to use it,\nthe FAQ in the page's language, today's prices, the terms and the privacy policy; public.",
