    "type": "object",
    "required": [
     "slug",
     "language",
     "title",
     "description",
     "updated",
     "path",
     "body"
    ],
    "title": "GuideOut",
    "description": "A guide article with its Markdown text."
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "HelpKnowledgeOut": {
    "properties": {
     "knowledge": {
      "type": "string",
      "title": "Knowledge"
     },
     "page_guide": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Page Guide"
     }
    },
    "type": "object",
    "required": [
     "knowledge"
    ],
    "title": "HelpKnowledgeOut",
    "description": "What the help chat answers from, in English: the platform guide (with the prices in the\nvisitor's currency) and the guide of the page asked on, as text, if it's a known page."
   },
   "LegalDocument": {
    "type": "string",
    "enum": [
     "terms",
     "privacy",
     "dpa"
    ],
    "title": "LegalDocument"
   },
   "LegalOut": {
    "properties": {
     "language": {
      "type": "string",
      "title": "Language"
