      "title": "Language"
     },
     "title": {
      "type": "string",
      "title": "Title"
     },
     "description": {
      "type": "string",
      "title": "Description"
     },
     "updated": {
      "type": "string",
      "title": "Updated"
     },
     "path": {
      "type": "string",
      "title": "Path"
     }
    },
    "type": "object",
    "required": [
     "slug",
     "language",
     "title",
     "description",
     "updated",
     "path"
    ],
    "title": "GuideItemOut",
    "description": "A guide article of the site: its title and summary in `language` (English until it's\ntranslated), and where the site shows it."
   },
   "GuideOut": {
    "properties": {
     "slug": {
