  "/internal/users/ids": {
   "get": {
    "tags": [
     "internal"
    ],
    "summary": "User Ids",
    "description": "Notifications, a page at a time: every account, for a notice about the terms or the\nprivacy policy; with a `setting`, the users who have it on (a campaign's product updates or\noffers).",
    "operationId": "user_ids_internal_users_ids_get",
    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "parameters": [
     {
      "name": "setting",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "enum": [
          "updates",
          "promotions"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Setting"
      }
     },
     {
      "name": "after",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "description": "The last id of the previous page",
       "default": "",
       "title": "After"
      },
      "description": "The last id of the previous page"
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 5000,
       "minimum": 1,
       "default": 5000,
       "title": "Limit"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/UserIdsOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
