  "/internal/events": {
   "post": {
    "tags": [
     "internal"
    ],
    "summary": "Receive Event",
    "description": "Pub/Sub pushes every event here. A failure answers with an error, so Pub/Sub retries it,\nand moves it to the dead-letter topic after the subscription's maximum attempts. An event no\nretry can handle is logged and acknowledged (handle_or_drop).",
    "operationId": "receive_event_internal_events_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PushBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "204": {
      "description": "Successful Response"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/internal/schedules/outbox": {
   "post": {
    "tags": [
     "schedules"
    ],
    "summary": "Flush Outbox",
    "description": "Every minute, from Cloud Scheduler: publishes events that weren't published right after\ntheir change (an account's deletion), and deletes those published a week ago.",
    "operationId": "flush_outbox_internal_schedules_outbox_post",
    "responses": {
     "204": {
      "description": "Successful Response"
     }
    }
   }
  },
  "/internal/schedules/erasures": {
   "post": {
    "tags": [
     "schedules"
    ],
    "summary": "Replay Erasures",
    "description": "Daily, from Cloud Scheduler, and by hand right after a database restore or clone: the\naccounts deleted in the backups' life are deleted again everywhere (safe to repeat).",
    "operationId": "replay_erasures_internal_schedules_erasures_post",
    "responses": {
     "204": {
      "description": "Successful Response"
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "AccountOut": {
    "properties": {
     "user_id": {
      "type": "string",
      "title": "User Id"
     },
     "email": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Email"
     },
     "created_at": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Created At"
     }
    },
    "type": "object",
    "required": [
     "user_id",
     "email",
     "created_at"
    ],
    "title": "AccountOut",
    "description": "A prepza account, for the admin zone's support tab: `email` is None for an account\nwithout one (a company's guest candidate), `created_at` when Firebase doesn't say."
   },
   "AdminEmailChangesIn": {
    "properties": {
     "changes": {
      "additionalProperties": {
       "type": "boolean"
      },
      "propertyNames": {
       "$ref": "#/components/schemas/EmailSetting"
      },
      "type": "object",
      "minProperties": 1,
      "title": "Changes"
     }
    },
    "type": "object",
    "required": [
     "changes"
    ],
    "title": "AdminEmailChangesIn",
    "description": "A superadmin's changes to a user's settings; the rest stay as they are."
   },
   "EmailAccountOut": {
    "properties": {
     "user_id": {
      "type": "string",
      "title": "User Id"
     },
     "email": {
      "type": "string",
      "title": "Email"
     },
     "preferences": {
      "$ref": "#/components/schemas/EmailPreferencesOut"
     }
    },
    "type": "object",
    "required": [
     "user_id",
     "email",
     "preferences"
    ],
    "title": "EmailAccountOut"
   },
   "EmailLookupOut": {
    "properties": {
     "account": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/EmailAccountOut"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object",
    "required": [
     "account"
    ],
    "title": "EmailLookupOut",
    "description": "The account with the address a superadmin looked up, or none."
   },
   "EmailPreferencesIn": {
    "properties": {
     "changes": {
      "additionalProperties": {
       "type": "boolean"
      },
      "propertyNames": {
       "$ref": "#/components/schemas/EmailSetting"
      },
      "type": "object",
      "minProperties": 1,
      "title": "Changes"
     },
     "source": {
      "type": "string",
      "enum": [
       "sign_in",
       "settings"
      ],
      "title": "Source"
     }
    },
    "type": "object",
    "required": [
     "changes",
     "source"
    ],
    "title": "EmailPreferencesIn",
    "description": "Only the settings to change; the rest stay as they are."
   },
   "EmailPreferencesOut": {
    "properties": {
     "candidate_finished": {
      "type": "boolean",
      "title": "Candidate Finished"
     },
     "invite_undelivered": {
      "type": "boolean",
      "title": "Invite Undelivered"
     },
     "ats_not_invited": {
      "type": "boolean",
      "title": "Ats Not Invited"
     },
     "interview_ready": {
      "type": "boolean",
      "title": "Interview Ready"
     },
     "reminders": {
      "type": "boolean",
      "title": "Reminders"
     },
     "updates": {
      "type": "boolean",
      "title": "Updates"
     },
     "promotions": {
      "type": "boolean",
      "title": "Promotions"
     }
    },
    "type": "object",
    "required": [
     "candidate_finished",
     "invite_undelivered",
     "ats_not_invited",
     "interview_ready",
     "reminders",
     "updates",
     "promotions"
    ],
    "title": "EmailPreferencesOut"
   },
   "EmailSetting": {
    "type": "string",
    "enum": [
     "candidate_finished",
     "invite_undelivered",
     "ats_not_invited",
     "interview_ready",
     "reminders",
     "updates",
     "promotions"
    ],
    "title": "EmailSetting",
    "description": "What a user may get by email beyond service emails, which always go out. The activity\ndigest's kinds are notification kinds."
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "MeOut": {
    "properties": {
     "uid": {
      "type": "string",
      "title": "Uid"
     },
     "email": {
      "type": "string",
      "title": "Email"
     },
     "email_verified": {
      "type": "boolean",
      "title": "Email Verified"
     },
     "name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Name"
     },
     "language": {
      "type": "string",
      "enum": [
       "en",
       "ru",
       "uk",
       "es",
       "pt",
       "de",
       "fr",
       "it",
       "pl",
       "nl",
