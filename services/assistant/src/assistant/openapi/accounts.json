  "/superadmin/stats": {
   "get": {
    "tags": [
     "superadmin"
    ],
    "summary": "Get Stats",
    "description": "Users who signed up, all time or in one year or month, for the stats tab.",
    "operationId": "get_stats_superadmin_stats_get",
    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "parameters": [
     {
      "name": "period",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
        },
        {
         "type": "null"
        }
       ],
       "title": "Period"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
