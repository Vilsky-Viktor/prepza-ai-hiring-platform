{
  "name": "frontend",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.12.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api-types": "openapi-typescript http://127.0.0.1:8090/api/library/openapi.json -o types/api/library.ts && openapi-typescript http://127.0.0.1:8090/api/generate/openapi.json -o types/api/generation.ts && openapi-typescript http://127.0.0.1:8090/api/rounds/openapi.json -o types/api/rounds.ts && openapi-typescript http://127.0.0.1:8090/api/companies/openapi.json -o types/api/companies.ts && openapi-typescript http://127.0.0.1:8090/api/billing/openapi.json -o types/api/billing.ts && openapi-typescript http://127.0.0.1:8090/api/notifications/openapi.json -o types/api/notifications.ts && openapi-typescript http://127.0.0.1:8090/api/ats/openapi.json -o types/api/ats.ts && prettier --write types/api",
    "check:messages": "node scripts/check-messages.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@paddle/paddle-js": "^1.6.5",
    "@sentry/nextjs": "^11.8.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "firebase": "^12.19.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
