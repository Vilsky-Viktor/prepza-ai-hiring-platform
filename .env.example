# Copy to .env before running docker compose. Sections run from the basics every run needs to the
# optional integrations; an empty optional value turns its feature off.

# ── The site ────────────────────────────────────────────────────────────────────────────────────

# Which environment this is, carried by Sentry's reports and Langfuse's traces: development
# locally, production in Google Cloud. Paddle's account is chosen separately (PADDLE_ENVIRONMENT).
ENVIRONMENT=development
# The site's address: emails link to it, and AI apps connect at <SITE_URL>/mcp.
SITE_URL=http://localhost:8090
# Superadmins, testee's own team (templates, the question bank): verified Google emails, comma-separated.
SUPERADMIN_EMAILS=

# Every usage limit (generations, the help chat, emails, the assistant, ...) is set in the admin
# zone's Controls tab, starting from its default in packages/common (limit_list.py), and so
# are the questions generated per topic, the topics and subtopics a test has, and the monthly
# AI budget the AI costs tab compares this month's spend with.

# ── Sign-in (Firebase) ──────────────────────────────────────────────────────────────────────────

# Firebase project. A "demo-" project id lets the Auth emulator run without real credentials.
FIREBASE_PROJECT_ID=demo-testee
# Local development only: while set, services accept unsigned tokens from the Auth emulator.
# docker-compose.yml passes it to the services, which refuse to start with it unless
# FIREBASE_PROJECT_ID starts with "demo-". Leave empty for a real Firebase project.
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth:9199
# The public web key, for the assistant: AI apps connected over MCP call the other services
# as the user, signed in with a custom token.
FIREBASE_WEB_API_KEY=demo-api-key

# Frontend (baked into the build).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-testee.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-testee
# Local development only: the browser talks to the Auth emulator here. Leave empty in production.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9199

# ── Human check (Cloudflare Turnstile) ──────────────────────────────────────────────────────────

# The "I'm not a robot" check (a job ad's link, a person's first company, an unpaid company's topic
# review, the contact form, a visitor's first help chat message). These are Cloudflare's test keys,
# which always pass; production uses the site's own (the secret in Secret Manager). An empty secret
# turns the check off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Databases and secrets ───────────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=testee
# Signs service-to-service tokens. Use a long random value (at least 32 characters).
SERVICE_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Signs the unsubscribe links in emails, so nobody can make one for someone else's address. Any
# long random string (`openssl rand -hex 32`); changing it breaks the links in emails already sent.
EMAIL_LINK_SECRET=local-email-link-secret
# Signs the titles link-preview pictures draw (/preview), so nobody else can put text under the
# logo. Any long random string; `openssl rand -hex 32` makes one.
PREVIEW_SECRET=
# Keys the hash of user ids in funnel events (analytics); in Google Cloud it's a secret. Required:
# without it, no event about a user is recorded.
ANALYTICS_SALT=local-analytics-salt
# Keys the hashes that stand for a person (a candidate's opted-out or suppressed address, a
# welcome gift's inbox), so a list of addresses can't match them; in Google Cloud it's a secret.
# Any long random string; changing it orphans the stored hashes (opt-outs stop working).
PERSON_HASH_KEY=local-person-hash-key

# Fernet keys that encrypt what companies connect. Make one with
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# To replace a key, list the new one and the old one, comma-separated, new first.
# ATS integrations (the ats service): companies' ATS keys. Empty turns integrations off.
ATS_ENCRYPTION_KEY=
# The public API (the api service): web hooks' signing secrets. Empty: API keys work, but web
# hooks can't be added.
API_ENCRYPTION_KEY=
# Slack: each company's channel web hook (see the Slack section).
SLACK_ENCRYPTION_KEY=

# ── AI (OpenAI) ─────────────────────────────────────────────────────────────────────────────────

# Question generation, the help chat and the in-app assistant.
OPENAI_API_KEY=
# Each AI task's OpenAI model, and how hard it thinks (none, minimal, low, medium, high; a
# reasoning model only).
# Generation: topics, questions and re-generated questions.
INTERVIEW_MODEL=gpt-6.1-sol
INTERVIEW_REASONING_EFFORT=low
# The verifier, which checks answer keys: rare, and it must be right.
VERIFY_MODEL=gpt-6.1-sol
VERIFY_REASONING_EFFORT=medium
# Translating news posts and campaign emails into every language.
TRANSLATION_MODEL=gpt-6.1-sol
TRANSLATION_REASONING_EFFORT=low
# The weekly quality patterns: recurring mistakes in flagged questions.
PATTERNS_MODEL=gpt-6.1-sol
PATTERNS_REASONING_EFFORT=medium
# Tagging the notation of questions' examples (the tag_code_languages job).
CODE_TAGS_MODEL=gpt-6.1-sol
CODE_TAGS_REASONING_EFFORT=low
# Checks that a pasted text names anything to test before a generation starts (the user waits).
SCREEN_MODEL=gpt-6-luna
SCREEN_REASONING_EFFORT=none
# Embeddings of topics and questions; a new model needs every stored topic embedded again.
EMBEDDING_MODEL=text-embedding-3-small
# The FAQ's help chat, free for everyone: fast and cheap. At none it also gets a temperature.
HELP_MODEL=gpt-6-luna
HELP_REASONING_EFFORT=none
# The in-app assistant: its chat model and how hard it thinks, the speech-to-text model for voice
# messages, and how many days a conversation nobody adds to is kept.
ASSISTANT_MODEL=gpt-6-luna
ASSISTANT_REASONING_EFFORT=low
# The conversations' titles in the assistant's history.
TITLE_MODEL=gpt-6-luna
TITLE_REASONING_EFFORT=none
# Picks the groups of tools each assistant turn is offered.
ROUTING_MODEL=gpt-6-luna
ROUTING_REASONING_EFFORT=none
TRANSCRIBE_MODEL=gpt-transcribe
ASSISTANT_RETENTION_DAYS=90

# Optional Langfuse tracing of every AI call (generation, the assistant, the help chat), with the
# votes on the chats' answers as scores; on only with both keys. The host defaults to Langfuse's
# EU cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Emails ──────────────────────────────────────────────────────────────────────────────────────

# With RESEND_API_KEY set they go out through Resend, from MAIL_FROM on a domain verified in
# Resend. Without it they go to mailpit (http://localhost:8125).
MAIL_FROM=testee. <no-reply@testee.local>
# Sender of the emails users may turn off (the activity digest, reminders), on a domain of its own
# (verified in Resend too), so spam complaints about them can't hurt the service emails.
MAIL_FROM_UPDATES=testee. <updates@mail.testee.local>
# Sender of candidates' emails (invites, reminders), sent for many companies to addresses they
# supply, so they can be watched apart; empty sends them from MAIL_FROM.
MAIL_FROM_CANDIDATES=
# Where contact page messages go (notifications), and replies to emails that have no one else to
# answer.
CONTACT_EMAIL=hello@testee.ai
RESEND_API_KEY=
# Signing secret (whsec_...) of the Resend webhook for bounces and complaints; see README.
RESEND_WEBHOOK_SECRET=
# Mailpit, locally.
SMTP_HOST=mailpit
SMTP_PORT=1025

# ── Payments (Paddle) ───────────────────────────────────────────────────────────────────────────

# "sandbox" for testing: it picks which Paddle account takes payments, so it's set on purpose,
# not from ENVIRONMENT. The client token is public by design; the webhook secret and the ids
# come from Paddle's dashboard. The key and the token must be that account's (pdl_sdbx_… and
# test_… for the sandbox), or billing doesn't start.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# The Paddle product every top-up is sold under; billing prices each one in its transaction, in
# the company's currency, tax added on top. Without it, nothing is sold.
PADDLE_PRODUCT_CANDIDATES=
# Automatic top-up, offered only with both: a $0 monthly price whose checkout saves the card,
# and a server-side API key (Developer tools → Authentication) that charges it.
PADDLE_PRICE_AUTO_TOP_UP=
PADDLE_API_KEY=

# ── Slack ───────────────────────────────────────────────────────────────────────────────────────

# testee's Slack app from api.slack.com (scope incoming-webhook, redirect URL
# <SITE_URL>/api/notifications/slack/callback, public distribution on); SLACK_ENCRYPTION_KEY
# (above) seals each company's channel web hook. Empty: "Add to Slack" says Slack isn't set up yet.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Monitoring and search engines ───────────────────────────────────────────────────────────────

# Error tracking (Sentry). Empty DSNs send nothing. The backend and the frontend are separate
# Sentry projects; the frontend's DSN is public by design (it's in the browser).
BACKEND_SENTRY_DSN=
FRONTEND_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# The tokens from Google Search Console's and Bing Webmaster Tools' meta-tag checks (frontend).
# Empty adds no tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
